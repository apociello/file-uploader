<% const currentId = locals.currentFolder?.id; %>
<aside class="sidebar">
  <nav class="sidebar__nav">
    <button type="button" class="nav-item" commandfor="new-folder-dialog" command="show-modal">
      <span class="nav-item__icon" style="--icon: url('/images/folder-plus.svg')"></span>
      <span class="nav-item__label">New folder</span>
    </button>

    <button type="button" class="nav-item" commandfor="new-file-dialog" command="show-modal">
      <span class="nav-item__icon" style="--icon: url('/images/file-plus.svg')"></span>
      <span class="nav-item__label">New file</span>
    </button>

    <hr class="sidebar__separator" />

    <a href="/dashboard" class="nav-item <%= currentId ? '' : 'nav-item--active' %>">
      <span class="nav-item__icon" style="--icon: url('/images/house.svg')"></span>
      <span class="nav-item__label"><%= username %></span>
    </a>

    <% systemFolders.forEach((folder) => { %>
      <a href="/folders/<%= folder.id %>" class="nav-item <%= folder.id === currentId ? 'nav-item--active' : '' %>">
        <span class="nav-item__icon" style="--icon: url('/images/<%= folder.icon %>.svg')"></span>
        <span class="nav-item__label"><%= folder.name %></span>
      </a>
    <% }); %>
  </nav>
</aside>
