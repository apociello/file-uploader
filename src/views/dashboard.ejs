<%- include('partials/head', { title: 'Dashboard' }) %>

<div class="app">
  <%- include('partials/header') %>

  <div class="app__body">
    <%- include('partials/sidebar') %>

    <main class="content">
      <h1><%= username %></h1>

      <button type="button" commandfor="new-folder-dialog" command="show-modal">New folder</button>

      <dialog id="new-folder-dialog" aria-labelledby="new-folder-title">
        <h2 id="new-folder-title">New folder</h2>

        <form action="/folders" method="POST">
          <div class="field">
            <label for="folder-name">Name</label>
            <input id="folder-name" name="name" type="text" autocomplete="off" autofocus required />
          </div>

          <button type="button" commandfor="new-folder-dialog" command="close">Cancel</button>
          <button type="submit">Create</button>
        </form>
      </dialog>

      <% if (folders.length === 0) { %>
        <p>No folders yet.</p>
      <% } else { %>
        <ul class="folder-grid">
          <% folders.forEach((folder) => { %>
            <li class="folder-card">
              <img src="/images/folder.svg" alt="" class="folder-card__icon" />
              <span class="folder-card__name"><%= folder.name %></span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </main>
  </div>
</div>

</body>
</html>
