<% const heading = currentFolder ? currentFolder.name : username; %>
<%- include('partials/head', { title: heading, stylesheet: 'dashboard' }) %>

<div class="app">
  <%- include('partials/header') %>

  <div class="app__body">
    <%- include('partials/sidebar') %>

    <main class="content">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <% if (currentFolder) { %>
            <li><a href="/dashboard"><%= username %></a></li>
            <% ancestors.forEach((ancestor) => { %>
              <li><a href="/folders/<%= ancestor.id %>"><%= ancestor.name %></a></li>
            <% }); %>
            <li aria-current="page"><%= currentFolder.name %></li>
          <% } else { %>
            <li aria-current="page"><%= username %></li>
          <% } %>
        </ol>
      </nav>

      <button type="button" class="btn" commandfor="new-folder-dialog" command="show-modal">New folder</button>

      <dialog id="new-folder-dialog" aria-labelledby="new-folder-title">
        <h2 id="new-folder-title" class="dialog__title">New folder</h2>

        <form action="/folders" method="POST">
          <div class="field">
            <label for="folder-name">Name</label>
            <input id="folder-name" name="name" type="text" autocomplete="off" autofocus required />
          </div>

          <div class="dialog__actions">
            <button type="button" class="btn" commandfor="new-folder-dialog" command="close">Cancel</button>
            <button type="submit" class="btn btn--primary">Create</button>
          </div>
        </form>
      </dialog>

      <% if (folders.length === 0) { %>
        <p class="empty">No folders yet.</p>
      <% } else { %>
        <ul class="folder-grid">
          <% folders.forEach((folder) => { %>
            <li>
              <a href="/folders/<%= folder.id %>" class="folder-card">
                <img src="/images/folder.svg" alt="" class="folder-card__icon" />
                <span class="folder-card__name"><%= folder.name %></span>
              </a>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </main>
  </div>
</div>

</body>
</html>
